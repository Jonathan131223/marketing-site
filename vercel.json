{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/contact",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/use-cases",
      "destination": "/library/usecases",
      "permanent": true
    },
    {
      "source": "/lifecycle-blueprints",
      "destination": "/library",
      "permanent": true
    },
    {
      "source": "/blog/webinar-emails",
      "destination": "/blog/webinar-email-sequence",
      "permanent": true
    },
    {
      "source": "/blog/saas-onboarding-checklist",
      "destination": "/blog/saas-onboarding-email-sequence",
      "permanent": true
    },
    {
      "source": "/blog/net-revenue-retention",
      "destination": "/blog/customer-retention-email-examples",
      "permanent": true
    },
    {
      "source": "/blog/aha-moment-examples",
      "destination": "/blog/customer-activation-email-examples",
      "permanent": true
    },
    {
      "source": "/blog/average-customer-retention-rate-saas",
      "destination": "/blog/customer-retention-email-examples",
      "permanent": true
    },
    {
      "source": "/blog/gross-churn-vs-net-churn",
      "destination": "/blog/customer-retention-email-examples",
      "permanent": true
    },
    {
      "source": "/blog/product-led-growth-metrics",
      "destination": "/blog/saas-email-benchmarks",
      "permanent": true
    },
    {
      "source": "/blog/product-led-growth-vs-marketing-led-growth",
      "destination": "/blog/saas-onboarding-email-sequence",
      "permanent": true
    },
    {
      "source": "/blog/product-led-growth-vs-sales-led-growth",
      "destination": "/blog/saas-onboarding-email-sequence",
      "permanent": true
    },
    {
      "source": "/blog/saas-gamification",
      "destination": "/blog/milestone-emails",
      "permanent": true
    },
    {
      "source": "/blog/user-engagement-strategy",
      "destination": "/blog/behavioral-email-marketing",
      "permanent": true
    },
    {
      "source": "/blog/jobs-to-be-done-examples",
      "destination": "/blog/saas-email-benchmarks",
      "permanent": true
    },
    {
      "source": "/blog/product-led-growth-flywheel",
      "destination": "/blog/saas-onboarding-email-sequence",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "library.digistorms.ai"
        }
      ],
      "destination": "https://www.digistorms.com/library",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "blog.digistorms.ai"
        }
      ],
      "destination": "https://www.digistorms.com/blog",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.digistorms.ai"
        }
      ],
      "destination": "https://www.digistorms.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "digistorms.ai"
        }
      ],
      "destination": "https://www.digistorms.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "digistorms.com"
        }
      ],
      "destination": "https://www.digistorms.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.digistorms.ai; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
